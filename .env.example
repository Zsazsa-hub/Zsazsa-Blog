# Copy this file to .env and fill in values for production

# Primary frontend domain
DOMAIN=example.com

# API domain (can be same as DOMAIN or subdomain like api.example.com)
API_DOMAIN=api.example.com

# Email used for Let's Encrypt registration
TRAEFIK_ACME_EMAIL=your-email@example.com

# Postgres credentials (change in production)
POSTGRES_USER=zsazsa
POSTGRES_PASSWORD=changeme
POSTGRES_DB=zsazsa

# JWT secret for backend
JWT_SECRET=replace_with_a_strong_secret

# Deploy host secrets (used by deploy workflow)
DEPLOY_HOST=your.server.ip.or.hostname
DEPLOY_USER=deployuser
DEPLOY_PATH=/home/deploy/zsazsa

# Optional: Docker registry user for pushing images
DOCKER_USERNAME=
DOCKER_PASSWORD=

# Optional S3 backup
AWS_S3_BUCKET=
AWS_REGION=ap-southeast-1

# Backup retention (days) - local backups older than this will be removed
BACKUP_RETENTION_DAYS=14

# Optional: GPG encryption for backups
# Either set BACKUP_GPG_RECIPIENT (existing public key in gpg keyring)
# or provide a path to an ASCII-armored public key file with BACKUP_GPG_PUBKEY_PATH
BACKUP_GPG_RECIPIENT=
BACKUP_GPG_PUBKEY_PATH=
# If true, delete the unencrypted backup after successful encryption
BACKUP_DELETE_PLAIN_AFTER_ENCRYPTION=false
